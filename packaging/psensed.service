[Unit]
Description=Predator Sense Linux daemon (fan/profile/lighting control for Acer Predator)
After=multi-user.target
Wants=systemd-modules-load.service

[Service]
Type=simple
ExecStart=/usr/sbin/psensed
Restart=on-failure
RestartSec=2
# The daemon does all privileged EC/WMI writes; clients talk through
# /run/psense.sock (root:wheel 0660). No persistent state — the daemon is
# stateless; config lives in each user's ~/.config/predator-sense-linux-*.
Nice=-5

[Install]
WantedBy=multi-user.target
