[Unit]
Description=Predator Sense Linux daemon (fan/profile/lighting control for Acer Predator)
After=multi-user.target
Wants=systemd-modules-load.service

[Service]
Type=simple
# best-effort module preload before the daemon starts (no-op when the DKMS
# autoload via /etc/modules-load.d/psense-wmi.conf already ran; '-' ignores
# failure so the unit is still startable on module-less runs)
ExecStartPre=-/sbin/modprobe psense-wmi
ExecStart=/usr/sbin/psensed
Restart=on-failure
RestartSec=2
# The daemon does all privileged EC/WMI writes; clients talk through
# /run/psense.sock (root:wheel 0660). No persistent state — the daemon is
# stateless; config lives in each user's ~/.config/predator-sense-linux-*.
Nice=-5
# ---- sandboxing (feat/hardening H1; conservative and daemon-compatible) ----
# Write paths the daemon legitimately needs:
#   /run                      socket + pid file (ProtectedSystem=strict keeps
#                             the rest of the fs read-only except /dev, /proc)
#   /var/lib/predator-sense   lighting state (/run/predator-sense fallback dir
#                             is created on demand under /run)
# sysfs writes (platform-profile, pwm, module parameters) are not covered by
# ProtectSystem and remain available; the EC path rides on /dev/psense-wmi.
ProtectSystem=strict
ReadWritePaths=/run /var/lib/predator-sense
PrivateTmp=true
NoNewPrivileges=true
ProtectControlGroups=true
RestrictAddressFamilies=AF_UNIX
# (ProtectKernelTunables MUST NOT be set: the daemon's core function is sysfs
#  writes. ProtectKernelModules left off so the ExecStartPre hook can run.)

[Install]
WantedBy=multi-user.target
