# Predator Sense Linux — RPM spec (Fedora 44, Predator PHN16-71)
#
# Build from the repo root:
#   packaging/make-tar.sh
#   rpmbuild -bb packaging/predator-sense.spec \
#       --define "_sourcedir $PWD/dist" --define "_rpmdir $PWD/dist/rpm"
# Lint:
#   rpmlint -r packaging/predator-sense.rpmlintrc \
#       packaging/predator-sense.spec dist/rpm/x86_64/*.rpm
#
# Packaging notes
#   * "main" package = psensed daemon + psense CLI (stdlib-only Python).
#   * "gui" subpackage = the exact-clone GUI: bundled Electron runtime
#     (~305 MB unpacked, prebuilt by upstream electron) carrying the stock
#     Acer renderer — proprietary payload, LicenseRef-Proprietary.
#   * "kmod" subpackage = psense-wmi out-of-tree module built against the
#     RUNNING kernel (kmod-style local build). After a kernel update either
#     rebuild/reinstall this subpackage or use the DKMS route documented in
#     src/psense-wmi/install-dkms.sh (shipped as kmod documentation).
#   * install.sh installs the same layout by hand; both routes may be mixed
#     without shadowing (same paths).
#   * User state lives in ~/.config/predator-sense-linux-*.json and
#     survives upgrades.

Name:           predator-sense
Version:        5.0.1463
Release:        5%{?dist}
Summary:        Acer Predator control for Linux (daemon, CLI, exact-clone GUI)

License:        GPL-2.0-or-later
URL:            https://www.acer.com/predator-sense
Source0:        %{name}-%{version}.tar.gz

# Kernel module built at package-build time against the host's running
# kernel (kmod-style); the vendor-module directory encodes it.
%global kver %(uname -r)
# Root of the bundled GUI payload (also the auto-dep filter boundary).
%global appdir  /opt/predator-sense

BuildRequires:  systemd-rpm-macros
BuildRequires:  hardlink

# Prebuilt Electron payload — no debuginfo, no stripping of it.
%global debug_package %{nil}
# Bundled runtime under /opt: its node_modules carry cross-arch/musl loaders
# (aarch64, armhf, musl) and vendored sonames (libffmpeg, libvulkan) whose
# autogenerated deps can never resolve from the distro. The real runtime
# requirements of the x86_64 Electron binary are declared explicitly in the
# gui subpackage Requires.
%global __requires_exclude_from ^%{appdir}/
%global __provides_exclude_from ^%{appdir}/

# The kernel module and the bundled Electron runtime are x86_64-only; the
# build host is pinned accordingly.
ExclusiveArch:  x86_64

%description
Linux reconstruction of Acer Predator Sense 5.0.1.463 for Predator Helios
Neo 16 (PHN16-71): stock-kernel surfaces via acer-wmi / platform-profile /
acer hwmon, a root daemon (psensed) exposing a JSON socket API on
/run/psense.sock, a CLI (psense), and the exact-clone Electron GUI running
the original Acer renderer through a Linux service shim.

Verified working surfaces: thermal/scenario profiles, per-fan control
(hwmon caps + vendor fan tables), keyboard RGB and boot-time lighting
apply, battery charge mode over the BatteryControl EC surface (read-back
verified, Optimized/Full), honest Checkup battery/storage checks, System
Info from sysfs plus SMBIOS, monitoring and app launching. The adaptive
AI-Smart charging mode is hidden when the machine's EC rejects that
function; nothing is faked.

For protocol detail, see the protocol spec shipped as documentation with
this package and the reverse-engineering evidence ledger it references.

%package kmod
Summary:        Whitelisted Acer WMI evaluation kernel module (psense-wmi)
License:        GPL-2.0-or-later

%description kmod
Out-of-tree character device /dev/psense-wmi exposing only whitelisted
Acer WMI method evaluations (GUID and method-id allow list, vendor 30 ms
pacing enforced in kernel). Built against the running kernel of the build
host; after a kernel update rebuild it or switch to the DKMS route
(described in the shipped documentation files). Required by the psensed
daemon for vendor WMI operations.

%package gui
Summary:        Predator Sense exact-clone GUI (stock Acer renderer plus Linux shim)
License:        LicenseRef-Proprietary
Requires:       %{name} = %{version}-%{release}
Requires:       hicolor-icon-theme
# Runtime libraries of the bundled Electron binary, provided by the distro.
Requires:       gtk3, nss, alsa-lib, libdrm, expat, libxkbcommon, mesa-libgbm
Requires:       libX11, libXcomposite, libXdamage, libXext, libXrandr
Requires:       libXScrnSaver, cups-libs, at-spi2-atk

%description gui
The Predator Sense GUI: the stock Acer Predator Sense renderer payload
(extracted from Acer's installer; Acer proprietary) talks MQTT/ddsc to a
Linux service shim which is backed by the psensed daemon. The payload runs
from /opt/predator-sense (bundled application, FHS opt).

%prep
%setup -q

%build
make -C src/psense-wmi KVER=%{kver}

%install
# ---------- daemon + CLI ----------
install -Dm755 src/psense  %{buildroot}%{_bindir}/psense
install -Dm755 src/psensed %{buildroot}%{_sbindir}/psensed
install -Dm755 scripts/psense-purified-voice.sh %{buildroot}%{_bindir}/psense-purified-voice
install -Dm755 scripts/psense-ai-charging.py    %{buildroot}%{_bindir}/psense-ai-charging

# ---------- systemd unit ----------
install -Dm644 packaging/psensed.service %{buildroot}%{_unitdir}/psensed.service

# ---------- man pages ----------
install -Dm644 packaging/man/psense.1         %{buildroot}%{_mandir}/man1/psense.1
install -Dm644 packaging/man/psensed.8        %{buildroot}%{_mandir}/man8/psensed.8
install -Dm644 packaging/man/predator-sense.1 %{buildroot}%{_mandir}/man1/predator-sense.1

# ---------- kernel module ----------
strip --strip-debug src/psense-wmi/psense-wmi.ko
install -Dm644 src/psense-wmi/psense-wmi.ko \
    %{buildroot}%{_prefix}/lib/modules/%{kver}/extra/psense-wmi/psense-wmi.ko

# ---------- GUI payload (bundled Electron + renderer) ----------
mkdir -p %{buildroot}%{appdir}
for item in app backend.js main.js preload.js lighting-engine.js ddsc-table.json tls \
            package.json package-lock.json bun.lock node_modules; do
    cp -a src/psense-electron/$item %{buildroot}%{appdir}/
done
# upstream npm/undici trees hold byte-identical copies; dedupe to real
# hardlinks so the payload ships without duplicated content
hardlink -c %{buildroot}%{appdir} 2>/dev/null
cat > %{buildroot}%{_bindir}/predator-sense <<'LAUNCH'
#!/bin/sh
# Predator Sense GUI launcher (original renderer + Linux shim)
cd /opt/predator-sense
exec ./node_modules/electron/dist/electron . "$@"
LAUNCH
chmod 755 %{buildroot}%{_bindir}/predator-sense

# ---------- icons + desktop ----------
install -Dm644 packaging/predator-sense-icon.png \
    %{buildroot}%{_datadir}/icons/hicolor/256x256/apps/predator-sense.png
install -Dm644 packaging/predator-sense.desktop \
    %{buildroot}%{_datadir}/applications/predator-sense.desktop

%check
python3 -m py_compile src/psense src/psensed scripts/psense-ai-charging.py
test -s src/psense-wmi/psense-wmi.ko
test -s packaging/predator-sense-icon.png

%files
%license LICENSE
%doc README.md CONTRIBUTING.md spec
%{_bindir}/psense
%{_bindir}/psense-purified-voice
%{_bindir}/psense-ai-charging
%{_sbindir}/psensed
%{_unitdir}/psensed.service
%{_mandir}/man1/psense.1*
%{_mandir}/man8/psensed.8*

%files kmod
%license LICENSE
%doc src/psense-wmi/psense-wmi.c src/psense-wmi/Makefile
%doc src/psense-wmi/dkms.conf src/psense-wmi/install-dkms.sh
%{_prefix}/lib/modules/%{kver}/extra/psense-wmi/psense-wmi.ko

%post
%systemd_post psensed.service

%preun
%systemd_preun psensed.service

%files gui
%license LICENSE
%{_mandir}/man1/predator-sense.1*
%dir %{appdir}
%{appdir}/*
%{_bindir}/predator-sense
%{_datadir}/icons/hicolor/256x256/apps/predator-sense.png
%{_datadir}/applications/predator-sense.desktop

%post kmod
depmod -a -F /boot/System.map-%{kver} %{kver} || :
modprobe psense-wmi 2>/dev/null || :

%postun kmod
depmod -a -F /boot/System.map-%{kver} %{kver} || :

