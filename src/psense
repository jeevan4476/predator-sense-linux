BATT_MODES = {"optimized": 0, "full": 1, "adaptive": 2}


def cmd_battmode(args):
    """Battery charge mode (CareCenter BatteryHealthy; ledger §13.25).
    Read-only GET needs root only inside the daemon; SET changes the EC's
    charging behaviour (hardware-persistent) — user-initiated on purpose."""
    op = {"op": "battmode.get"} if (args.action == "get") else {"op": "battmode.set"}
    if args.action == "set":
        if args.value is None:
            sys.exit("battmode set <0|1|2|optimized|full|adaptive> required")
        try:
            op["value"] = BATT_MODES[str(args.value).lower()] \
                if str(args.value).lower() in BATT_MODES else int(args.value)
        except ValueError:
            sys.exit("value must be an int or one of " + ", ".join(BATT_MODES))
        if not (0 <= op["value"] <= 2):
            sys.exit("value must be 0 (optimized), 1 (full) or 2 (adaptive)")
    r = daemon_req(op, args.sock, 20)
    if r is None:
        sys.exit(2)
    print(json.dumps(r, indent=2))
    if r.get("error"):
        sys.exit(1)


def cmd_usbcharge(args):
    """Power-off USB charge (QuickAccess USBChargeSwitch / USBCharge; ledger §13.29).
    Read-only GET needs root only inside the daemon; SET changes EC USB charge
    state and battery threshold (10%, 20%, 30%)."""
    if args.action == "get":
        op = {"op": "usbcharge.get"}
    else:
        op = {"op": "usbcharge.set"}
        if args.value is not None:
            v = str(args.value).lower().rstrip("%")
            if v in ("on", "enable", "enabled", "true", "1"):
                op["enabled"] = True
            elif v in ("off", "disable", "disabled", "false", "0"):
                op["enabled"] = False
            elif v in ("10", "20", "30"):
                op["threshold"] = int(v)
            else:
                sys.exit("value must be on|off or 10|20|30")
        if args.threshold is not None:
            if args.threshold not in (10, 20, 30):
                sys.exit("--threshold must be 10, 20, or 30")
            op["threshold"] = args.threshold
        if "enabled" not in op and "threshold" not in op:
            sys.exit("usbcharge set <on|off|10|20|30> [--threshold 10|20|30] required")
    r = daemon_req(op, args.sock, 20)
    if r is None:
        sys.exit(2)
    print(json.dumps(r, indent=2))
    if r.get("error"):
        sys.exit(1)


def cmd_switchkey(args):
    sock = getattr(args, "sock", "/run/psense.sock")
    if args.action == "get":
        res = daemon_req({"op": "switchkey.get"}, sock=sock)
        if "error" in res:
            sys.exit(f"error: {res['error']}")
        mode = res.get("mode", 0)
        print("cycle" if mode == 0 else "turbo")
    elif args.action == "set":
        val = args.value
        if not val:
            sys.exit("value required: cycle or turbo")
        mode = 0 if val.lower() in ("0", "cycle", "cycleswitch") else 1
        res = daemon_req({"op": "switchkey.set", "mode": mode}, sock=sock)
        if res.get("status") != 0:
            sys.exit(f"error: {res.get('error', 'set failed')}")
        print(f"mode switch key -> {'cycle' if mode == 0 else 'turbo'}")


# ---------------------------------------------------------------- checkup
def cmd_checkup(args):
    # System
    product = read("/sys/class/dmi/id/product_name") or read("/sys/class/dmi/id/board_name") or "Acer Predator Laptop"
    bios = read("/sys/class/dmi/id/bios_version") or "Unknown"
    kernel_release = read("/proc/sys/kernel/osrelease") or platform.release()
    kernel = f"Linux {kernel_release}"
    os_name = "Linux"
    try:
        for ln in open("/etc/os-release"):
            if ln.startswith("PRETTY_NAME="):
                os_name = ln.split("=", 1)[1].strip().strip('"')
                break
    except OSError:
        pass

    # Battery
    bat = {}
    for p in sorted(glob.glob("/sys/class/power_supply/BAT*")):
        full, design = 0, 0
        for k_full, k_des in [("charge_full", "charge_full_design"), ("energy_full", "energy_full_design")]:
            try:
                cf = int(read(f"{p}/{k_full}") or 0)
                cd = int(read(f"{p}/{k_des}") or 0)
                if cd > 0:
                    full, design = cf, cd
                    break
            except (ValueError, TypeError):
                continue
        cycle_count = 0
        try:
            cycle_count = int(read(f"{p}/cycle_count") or 0)
        except (ValueError, TypeError):
            pass
        capacity = 0
        try:
            capacity = int(read(f"{p}/capacity") or 0)
        except (ValueError, TypeError):
            pass
        status = read(f"{p}/status") or "Unknown"

        if design > 100000:
            full_mah = round(full / 1000)
            design_mah = round(design / 1000)
        else:
            full_mah = full
            design_mah = design

        health_pct = min(100, round(full_mah * 100 / design_mah)) if design_mah > 0 else 100
        wear_level = max(0, 100 - health_pct)

        bat = {
            "capacity": capacity,
            "design_capacity": design_mah,
            "full_capacity": full_mah,
            "cycle_count": cycle_count,
            "wear_level_pct": wear_level,
            "health_pct": health_pct,
            "status": status,
        }
        break

    # If battery sysfs gave no design/full, fallback to daemon health if available
    sock = getattr(args, "sock", "/run/psense.sock")
    daemon_health = daemon_req({"op": "health"}, sock=sock, silent=True) or {}
    if not bat or not bat.get("design_capacity"):
        dh_bat = daemon_health.get("battery", {})
        if dh_bat:
            full_raw = dh_bat.get("battery_full_raw", 0)
            des_raw = dh_bat.get("battery_design_raw", 0)
            full_mah = round(full_raw / 1000000) if full_raw > 100000 else full_raw
            des_mah = round(des_raw / 1000000) if des_raw > 100000 else des_raw
            health_pct = min(100, round(full_mah * 100 / des_mah)) if des_mah > 0 else 100
            wear_level = max(0, 100 - health_pct)
            bat = {
                "capacity": bat.get("capacity", 0),
                "design_capacity": des_mah,
                "full_capacity": full_mah,
                "cycle_count": dh_bat.get("battery_cycle_count", 0),
                "wear_level_pct": wear_level,
                "health_pct": health_pct,
                "status": dh_bat.get("battery_status", "Unknown"),
            }

    # Storage / NVMe
    h_disks = {d.get("dev"): d for d in daemon_health.get("disks", []) if d.get("dev")}
    storage_drives = []
    for b in sorted(glob.glob("/sys/class/block/*")):
        dev = os.path.basename(b)
        if dev.startswith(("loop", "zram", "ram", "dm-")):
            continue
        if dev.startswith("nvme") and not dev.endswith("n1"):
            continue
        if dev.startswith("sd") and dev[-1].isdigit():
            continue
        model = (read(f"{b}/device/model") or read(f"{b}/device/name") or "").strip()
        if not model:
            continue
        dev_path = f"/dev/{dev}"

        temp_c = None
        crit_warning = 0
        hw = glob.glob(f"{b}/device/hwmon*/temp1_input")
        if not hw and dev.startswith("nvme"):
            for h in glob.glob("/sys/class/hwmon/hwmon*"):
                if read(f"{h}/name") == "nvme":
                    hw.append(f"{h}/temp1_input")
        for tc in hw:
            raw = read(tc)
            if raw:
                try:
                    t = int(raw)
                    temp_c = round(t / 1000) if t > 1000 else t
                    alarm_f = tc.replace("temp1_input", "temp1_alarm")
                    if os.path.exists(alarm_f):
                        crit_warning = int(read(alarm_f) or 0)
                    break
                except ValueError:
                    pass

        smart_verdict = "PASSED (Good)"
        if dev_path in h_disks:
            hd = h_disks[dev_path]
            st = hd.get("smart_status", "")
            if "passed" in st.lower():
                smart_verdict = "PASSED (Good)"
            elif st:
                smart_verdict = f"{st} (Warning)"
            elif hd.get("health") == 0:
                smart_verdict = "PASSED (Good)"
        else:
            try:
                r = subprocess.run(["smartctl", "-H", dev_path],
                                   capture_output=True, text=True, timeout=3)
                txt = (r.stdout or "") + (r.stderr or "")
                for ln in txt.splitlines():
                    if "result:" in ln.lower():
                        st = ln.split(":", 1)[1].strip()
                        if "passed" in st.lower():
                            smart_verdict = "PASSED (Good)"
                        else:
                            smart_verdict = f"{st} (Warning)"
                        break
            except Exception:
                pass

        storage_drives.append({
            "drive": f"{model} ({dev_path})",
            "device": dev_path,
            "model": model,
            "smart_health": smart_verdict,
            "temperature_c": temp_c,
            "critical_warnings": crit_warning,
        })

    # Memory
    mem_total_kb, mem_avail_kb = 0, 0
    try:
        for ln in open("/proc/meminfo"):
            if ln.startswith("MemTotal:"):
                mem_total_kb = int(ln.split()[1])
            elif ln.startswith("MemAvailable:"):
                mem_avail_kb = int(ln.split()[1])
    except OSError:
        pass

    mem_used_kb = max(0, mem_total_kb - mem_avail_kb)
    mem_usage_pct = round(mem_used_kb * 100 / mem_total_kb) if mem_total_kb > 0 else 0

    mem_hw = daemon_req({"op": "memory"}, sock=sock, silent=True) or {}
    ram_type = mem_hw.get("type") or "DDR5"
    ram_freq = mem_hw.get("frequency") or 4800
    total_mb = mem_hw.get("total_mb")
    if total_mb and total_mb > 0:
        total_gb = round(total_mb / 1024)
    else:
        total_gb = round(mem_total_kb / 1048576)

    used_gb = round(mem_used_kb / 1048576, 1)
    avail_gb = round(mem_avail_kb / 1048576, 1)

    payload = {
        "system": {
            "product_name": product,
            "bios_version": bios,
            "kernel": kernel,
            "os": os_name,
        },
        "battery": bat,
        "storage": storage_drives,
        "ram": {
            "total_gb": total_gb,
            "available_gb": avail_gb,
            "used_gb": used_gb,
            "usage_pct": mem_usage_pct,
            "total_kb": mem_total_kb,
            "available_kb": mem_avail_kb,
            "used_kb": mem_used_kb,
            "type": ram_type,
            "frequency_mhz": ram_freq,
        },
    }

    if getattr(args, "json", False):
        print(json.dumps(payload, indent=2))
        return

    # Clean formatted terminal output
    print("================ Predator Sense Hardware Checkup ================")
    print(f"System:  {product} (BIOS {bios})")
    print(f"Kernel:  {kernel}")
    print()
    print("[Battery]")
    if bat:
        print(f"  Health:       {bat['health_pct']}% (Design: {bat.get('design_capacity', 0)} mAh, Full: {bat.get('full_capacity', 0)} mAh)")
        print(f"  Wear Level:   {bat['wear_level_pct']}%")
        print(f"  Cycle Count:  {bat.get('cycle_count', 0)}")
        print(f"  Status:       {bat.get('status', 'Unknown')} ({bat.get('capacity', 0)}%)")
    else:
        print("  Status:       Not Available")
    print()
    print("[Storage]")
    if storage_drives:
        for d in storage_drives:
            print(f"  Drive:        {d['model']} ({d['device']})")
            print(f"  SMART Health: {d['smart_health']}")
            temp_str = f"{d['temperature_c']}°C" if d['temperature_c'] is not None else "N/A"
            print(f"  Temperature:  {temp_str}")
            if d.get("critical_warnings", 0) > 0:
                print(f"  Critical:     {d['critical_warnings']}")
    else:
        print("  Drive:        None detected")
    print()
    print("[Memory]")
    print(f"  RAM Total:    {total_gb} GB (Used: {used_gb} GB / {mem_usage_pct}%)")
    if ram_type and ram_freq:
        print(f"  Type:         {ram_type} @ {ram_freq} MHz")
    elif ram_type:
        print(f"  Type:         {ram_type}")
    print("=================================================================")


# ---------------------------------------------------------------- ui launcher
def cmd_ui(_):
    candidates = [
        "/usr/bin/predator-sense",
        "/opt/predator-sense/app/predator-sense",
        "/opt/predator-sense/predator-sense",
    ]
    which_ps = shutil.which("predator-sense")
    if which_ps and which_ps not in candidates:
        candidates.append(which_ps)

    exe = None
    for c in candidates:
        if os.path.isfile(c) and os.access(c, os.X_OK):
            exe = c
            break

    if not exe:
        repo_root = os.path.abspath(os.path.join(os.path.dirname(__file__), ".."))
        local_app = os.path.join(repo_root, "src/psense-electron")
        el = shutil.which("electron")
        if os.path.isdir(local_app) and el:
            cmd = [el, local_app]
        else:
            sys.exit("error: Predator Sense UI executable not found (/usr/bin/predator-sense)")
    else:
        cmd = [exe]

    try:
        proc = subprocess.Popen(
            cmd,
            stdout=subprocess.DEVNULL,
            stderr=subprocess.DEVNULL,
            stdin=subprocess.DEVNULL,
            start_new_session=True,
            close_fds=True,
        )
        print(f"Predator Sense UI launched in background (PID {proc.pid})")
    except OSError as e:
        sys.exit(f"error launching UI: {e}")


def main():
    ap = argparse.ArgumentParser(prog="psense", description=__doc__)
    sub = ap.add_subparsers(dest="cmd", required=True)

    sub.add_parser("sensors", help="fan rpm + temperatures (JSON)")
    sub.add_parser("info", help="platform/tooling state (JSON)")

    p = sub.add_parser("checkup", help="hardware diagnostics and health checkup")
    p.add_argument("--json", action="store_true", help="output as JSON")
    p.add_argument("--sock", default="/run/psense.sock")

    sub.add_parser("ui", help="launch Predator Sense GUI detached in background")

    p = sub.add_parser("profile", help="thermal profile get|list|set")
    p.add_argument("action", nargs="?", choices=["get", "list", "set"], default="get")
    p.add_argument("value", nargs="?", default=None)

    p = sub.add_parser("fan", help="fan status|mode|speed|reset|sweep + wmode|wspeed|wget|wmodes|wtable")
    p.add_argument("action", choices=["status", "mode", "speed", "reset", "sweep",
                                      "wmode", "wspeed", "wget", "wmodes", "wtable"])
    p.add_argument("value", nargs="?", default=None)
    p.add_argument("--fan", choices=["cpu", "gpu", "both"], default=None)
    p.add_argument("--start", default=20)
    p.add_argument("--stop", default=100)
    p.add_argument("--step", default=10)
    p.add_argument("--sock", default="/run/psense.sock")

    p = sub.add_parser("kb", help="keyboard backlight via psensed: get|zone|set|restore|effect")
    p.add_argument("action", choices=["get", "zone", "set", "restore", "effect"], default="get", nargs="?")
    p.add_argument("mode", nargs="?", default=None,
                   help="kb set/effect: mode or effect name (wave|breathing|shifting|meteor|twinkling|stop|status)")
    p.add_argument("--rgb", default=None, help='"R,G,B"')
    p.add_argument("--color", default=None, help='kb effect: color ("00ffcc", "#00ffcc", or "R,G,B")')
    p.add_argument("--zones", default=None, help='kb zone(s): "1,2,3,4" or "all" (zone)')
    p.add_argument("--speed", default=None, help="effect speed (1..9, default 3 for effect; int for set)")
    p.add_argument("--brightness", default=None, metavar="N",
                   help="brightness (0..100 for effect, default 100; 0..255 for set)")
    p.add_argument("--direction", "--dir", dest="dir", default=None,
                   help="direction: 1|right, 2|left (default 1 for effect)")
    p.add_argument("--device", default=1, help="kb set: device byte, 1=kb (int)")
    p.add_argument("--json", action="store_true", help="output as JSON")
    p.add_argument("--sock", default="/run/psense.sock")

    p = sub.add_parser("wmi", help="raw whitelisted WMI eval via psensed")
    p.add_argument("guid", choices=["gaming", "apge", "battery", "generic"])
    p.add_argument("mid", type=int, help="WmiMethodId")
    p.add_argument("in_hex", nargs="?", default=None, help="input bytes as hex")
    p.add_argument("--out", type=int, default=64, help="output buffer size")
    p.add_argument("--sock", default="/run/psense.sock")

    p = sub.add_parser("curve", help="userspace temp→pct curves via psensed: show|set|clear")
    p.add_argument("action", choices=["show", "set", "clear"])
    p.add_argument("--fan", choices=["cpu", "gpu"], default="cpu")
    p.add_argument("--points", default=None, help='"40:25 60:45 80:70 90:100"')
    p.add_argument("--sock", default="/run/psense.sock")

    p = sub.add_parser("battmode", help="battery charge mode: get|set (misc opcode 0x02)")
    p.add_argument("action", choices=["get", "set"], nargs="?", default="get")
    p.add_argument("value", nargs="?", default=None,
                   help="set: 0|1|2 or optimized|full|adaptive")
    p.add_argument("--sock", default="/run/psense.sock")

    p = sub.add_parser("usbcharge", help="power-off USB charge: get|set (APGeAction 0x04)")
    p.add_argument("action", choices=["get", "set"], nargs="?", default="get")
    p.add_argument("value", nargs="?", default=None,
                   help="set: on|off or 10|20|30")
    p.add_argument("--threshold", type=int, choices=[10, 20, 30], default=None,
                   help="battery limit %% (10, 20, 30)")
    p.add_argument("--sock", default="/run/psense.sock")

    p = sub.add_parser("switchkey", help="physical mode switch key behavior: get|set (cycle|turbo)")
    p.add_argument("action", choices=["get", "set"], nargs="?", default="get")
    p.add_argument("value", nargs="?", choices=["cycle", "turbo", "0", "1"], default=None)
    p.add_argument("--sock", default="/run/psense.sock")

    args = ap.parse_args()
    {"sensors": cmd_sensors, "info": cmd_info, "profile": cmd_profile, "fan": cmd_fan,
     "curve": cmd_curve, "kb": cmd_kb, "wmi": cmd_wmi, "battmode": cmd_battmode,
     "usbcharge": cmd_usbcharge, "switchkey": cmd_switchkey,
     "checkup": cmd_checkup, "ui": cmd_ui}[args.cmd](args)


if __name__ == "__main__":
    main()
