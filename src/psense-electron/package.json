{
  "name": "predator-sense-linux-electron",
  "version": "5.0.1463",
  "description": "Acer PredatorSense UI (original renderer) on Linux — ddsc shim maps window.ddsc.<module>.<func> to the local psensed daemon",
  "main": "main.js",
  "channel": "LinuxShim",
  "private": true,
  "packageManager": "bun@1.4.2",
  "engines": {
    "bun": ">=1.0.0",
    "npm": "please-use-bun",
    "yarn": "please-use-bun",
    "pnpm": "please-use-bun"
  },
  "scripts": {
    "preinstall": "case \"${npm_config_user_agent:-}\" in bun/*) ;; *) echo 'Error: This project enforces Bun. Use `bun install` instead of npm/yarn/pnpm.' >&2; exit 1 ;; esac",
    "start": "electron .",
    "typecheck": "tsc -p . --noEmit",
    "build": "tsc -p .",
    "test": "bun ../../tests/test_backend_lighting.js && bun test ../../tests/test_lighting_engine.js ../../tests/test_daemon_protocol.js",
    "generate:ddsc": "bun generate-ddsc-dts.mjs"
  },
  "dependencies": {
    "@electron/remote": "^2.1.3",
    "aedes": "^0.46.3",
    "electron": "^44.9.0",
    "mqtt": "^4.3.7",
    "websocket-stream": "^5.5.2"
  },
  "devDependencies": {
    "@types/node": "24",
    "typescript": "5.9.3"
  }
}
