#!/usr/bin/env python3
"""psensed — Predator Sense Linux daemon (PHN16-71 family).

Root daemon over the stock-kernel surfaces (platform-profile + acer hwmon).
Exposes a newline-JSON API on a unix socket; clients (CLI/GUI) connect without
their own root privileges — the socket is owner root, group wheel.

Spec: ../spec/protocol.md   Ledger: ../analysis/wmi-methods.md

Ops (request = one JSON object + '\n', reply = one JSON object):
  sensors                              cached rpm/temps (2 s TTL)
  info                                 platform/tooling state
  profile.get / profile.set {name}
  fan.get                              rpm + per-fan pwm/enable/mode
  fan.mode    {mode, fan?}             auto|turbo|custom
  fan.speed   {pct, fan?}              fixed custom % (long-term)
  fan.reset                            firmware auto for all fans
  fan.curve.set {fan, points, }        userspace temp→% curve (tick scheduler)
  fan.curve.get / fan.curve.clear{fan}
  wmi.raw     {guid, mid, in?(hex), out_len?}   raw eval through psense-wmi.ko
  kb.get                                      keyboard state (method 21)
  kb.zone.set {zones, rgb[r,g,b]}             per-zone colors (method 6)
  kb.set      {mode, rgb, speed, brightness, dir, device}  16-byte frame (method 20)
  fan.wmode   {fan, mode}                     auto|turbo|custom (method 14)
  fan.wspeed  {pct, fan}                      custom % (methods 16+14)
  fan.wget/get/fan.wmodes {fan}              register + mode reads (17/15)
  fan.wtable                                  EC fan-table staging word (19)
  memory                                      SMBIOS type-17 scan (RAM freq/type)
  sysinfo                                     wsinfo snapshot (DMI/BIOS/OS/CPU/RAM/
                                              storage/battery/network/devices, 30 s cache)
  health                                      checkup health: battery design/full ratio,
                                              per-disk smartctl -H verdict (root-only)
                                              (§13.24; RAM has no runtime diagnostic on
                                              Linux — renderer gets an honest 1004)
  battmode.get                          battery charge mode truth (BatteryControl
                                        id 20 BE*: function list + status array)
  battmode.set {value}                  charge-mode switch (BatteryControl id 21
                                        BE*: two-switch flow, EC-verified;
                                        adaptive rejected by this EC) (§13.26)
  usbcharge.get                         power-off USB charge state (APGeAction
                                        id 2 GetFunction(0x04): enabled + threshold %)
  usbcharge.set {enabled?, threshold?}  power-off USB charge write (APGeAction
                                        id 1 SetFunction(0x04|sw<<8|thr<<16), EC-verified) (§13.29)
  profile.get / profile.set {name}            platform-profile drives their 4 modes
  gpu.oc.get                            GPU overclocking status (OEM profile offsets)
  gpu.oc.set  {core, mem}               manual GPU core/memory clock offsets
"""

