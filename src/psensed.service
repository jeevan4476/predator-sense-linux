[Unit]
Description=Predator Sense Linux daemon (PS fan/profile control for Acer Predator/Nitro)
After=multi-user.target
Wants=systemd-modules-load.service

[Service]
Type=simple
ExecStart=/usr/bin/python3 /home/img1/projects/predator-sense-linux/src/psensed
Restart=on-failure
RestartSec=2
# The daemon does all privileged writes; clients talk through
# /run/psense.sock (root:wheel 0660).
Nice=-5

[Install]
WantedBy=multi-user.target
