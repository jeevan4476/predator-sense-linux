#!/bin/sh
# Launcher: runs the legacy PySide GUI from a repo checkout (portable —
# resolves its own location; the packaged GUI is the Electron one under
# /opt/predator-sense, so this is only for development against the repo).
SELF_DIR=$(CDPATH= cd -- "$(dirname -- "$0")" && pwd)
REPO_ROOT=$(CDPATH= cd -- "$SELF_DIR/.." && pwd)
exec "$REPO_ROOT/.venv/bin/python" "$SELF_DIR/main.py" "$@"
